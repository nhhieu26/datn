# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# NextAuth (tạo secret: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Google Gemini (AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Pinecone (vector search)
PINECONE_API_KEY=""
PINECONE_INDEX=""
PINECONE_NAMESPACE_TOURS="tours"
PINECONE_NAMESPACE_HOTELS="hotels"
PINECONE_NAMESPACE_RESTAURANTS="restaurants"
PINECONE_NAMESPACE_DESTINATIONS="destinations"

# ImageKit (upload ảnh)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Booking & thanh toán
PLATFORM_COMMISSION_RATE=0.1
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Tài khoản admin (dùng cho bun run db:seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""

# Test commit
