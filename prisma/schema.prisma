generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  provider
  admin
}

enum UserStatus {
  active
  inactive
  banned
}

enum BusinessType {
  tour
  hotel
  restaurant
}

enum ApprovalStatus {
  not_submitted
  pending
  approved
  rejected
}

enum ProvinceType {
  province
  city
}

enum ServiceStatus {
  published
  paused
}

enum TourDepartureStatus {
  scheduled
  full
  cancelled
  completed
}

enum BookingStatus {
  pending_payment
  pending_confirmation
  paid
  confirmed
  completed
  cancelled
  expired
  no_show
}

enum PaymentGateway {
  paypal
}

enum TransactionStatus {
  pending
  processing
  succeeded
  failed
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String     @unique
  password            String
  fullname            String
  status              UserStatus @default(active)
  onboardingCompleted Boolean    @default(false)
  preferences         Json       @default("{}")
  role                Role

  providerProfiles   ProviderProfile[]
  tourBookings       TourBooking[]
  hotelBookings      HotelBooking[]
  restaurantBookings RestaurantBooking[]
  reviews            Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  businessType       BusinessType
  taxCode            String?
  licenseUrl         String?
  website            String?
  address            String?
  description        String?
  photoUrl           String?
  photoFileId        String?
  signatureUrl       String?
  signatureFileId    String?
  signatureUpdatedAt DateTime?
  approvalStatus     ApprovalStatus @default(not_submitted)
  rejectionReason    String?
  payoutEmail        String
  paypalPayerId      String
  paypalLinkedAt     DateTime

  tours              Tour[]
  hotels             Hotel[]
  restaurants        Restaurant[]
  tourBookings       TourBooking[]
  hotelBookings      HotelBooking[]
  restaurantBookings RestaurantBooking[]
  payouts            Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessType])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  tours        TourTag[]
  hotels       HotelTag[]
  restaurants  RestaurantTag[]
  destinations DestinationTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Province {
  id       String       @id @default(cuid())
  name     String       @unique
  fullName String
  slug     String       @unique
  type     ProvinceType
  imageUrl String?

  tours        Tour[]
  hotels       Hotel[]
  restaurants  Restaurant[]
  destinations Destination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  description       String?
  images            Json            @default("[]")
  itinerary         Json            @default("[]")
  includeServices   String[]        @default([])
  excludeServices   String[]        @default([])
  durationDays      Int
  durationNights    Int
  basePrice         Decimal         @db.Decimal(12, 2)
  status            ServiceStatus   @default(published)
  ratingAvg         Decimal         @default(0) @db.Decimal(2, 1)
  reviewCount       Int             @default(0)
  // Provider xóa tour: dừng ngay, cron xóa mềm khi tới hạn
  deleteScheduledAt DateTime?
  deletedAt         DateTime?

  tags       TourTag[]
  departures TourDeparture[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleteScheduledAt])
}

model TourTag {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([tourId, tagId])
}

model TourDeparture {
  id            String              @id @default(cuid())
  tourId        String
  tour          Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime?
  price         Decimal?            @db.Decimal(12, 2)
  totalSlots    Int
  bookedSlots   Int                 @default(0)
  status        TourDepartureStatus @default(scheduled)

  bookings TourBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hotel {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  images            Json            @default("[]")
  amenities         String[]        @default([])
  status            ServiceStatus   @default(published)
  ratingAvg         Decimal         @default(0) @db.Decimal(2, 1)
  reviewCount       Int             @default(0)
  // Provider xóa khách sạn: dừng ngay, cron xóa mềm khi tới hạn
  deleteScheduledAt DateTime?
  deletedAt         DateTime?

  tags    HotelTag[]
  rooms   Room[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleteScheduledAt])
}

model HotelTag {
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([hotelId, tagId])
}

model Room {
  id          String        @id @default(cuid())
  hotelId     String
  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  images      Json          @default("[]")
  capacity    Int
  quantity    Int
  basePrice   Decimal       @db.Decimal(12, 2)
  amenities   String[]      @default([])
  status      ServiceStatus @default(published)

  bookings HotelBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  phone             String?
  capacity          Int
  images            Json            @default("[]")
  menu              Json            @default("[]")
  status            ServiceStatus   @default(published)
  ratingAvg         Decimal         @default(0) @db.Decimal(2, 1)
  reviewCount       Int             @default(0)
  // Provider xóa nhà hàng: dừng ngay, cron xóa mềm khi tới hạn
  deleteScheduledAt DateTime?
  deletedAt         DateTime?

  tags      RestaurantTag[]
  timeSlots RestaurantTimeSlot[]
  bookings  RestaurantBooking[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleteScheduledAt])
}

model RestaurantTag {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([restaurantId, tagId])
}

model RestaurantTimeSlot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startTime    String
  endTime      String

  bookings RestaurantBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, startTime])
}

model Destination {
  id          String   @id @default(cuid())
  provinceId  String
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  address     String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  openTime    String
  closeTime   String
  images      Json     @default("[]")
  ticketPrice Decimal? @db.Decimal(12, 2)
  isPublished Boolean  @default(true)

  tags DestinationTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DestinationTag {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([destinationId, tagId])
}

model TourBooking {
  id                String          @id @default(cuid())
  code              String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  tourDepartureId   String?
  tourDeparture     TourDeparture?  @relation(fields: [tourDepartureId], references: [id], onDelete: SetNull)
  tourTitle         String
  departureDate     DateTime
  guests            Int
  status            BookingStatus   @default(pending_payment)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  unitPrice      Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  commissionRate Decimal @db.Decimal(5, 4)
  platformFee    Decimal @db.Decimal(12, 2)
  providerAmount Decimal @db.Decimal(12, 2)

  expiresAt    DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payments Payment[]
  refunds  Refund[]
  payout   Payout?
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([providerProfileId, status])
  @@index([status, departureDate])
}

model HotelBooking {
  id                String          @id @default(cuid())
  code              String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  roomId            String?
  room              Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  hotelName         String
  roomName          String
  checkInDate       DateTime
  checkOutDate      DateTime
  nights            Int
  roomQuantity      Int
  guests            Int
  status            BookingStatus   @default(pending_payment)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  unitPrice      Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  commissionRate Decimal @db.Decimal(5, 4)
  platformFee    Decimal @db.Decimal(12, 2)
  providerAmount Decimal @db.Decimal(12, 2)

  expiresAt    DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payments Payment[]
  refunds  Refund[]
  payout   Payout?
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, checkInDate, checkOutDate])
  @@index([customerId])
  @@index([providerProfileId, status])
  @@index([status, checkOutDate])
}

model RestaurantBooking {
  id                   String              @id @default(cuid())
  code                 String              @unique
  customerId           String
  customer             User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId    String
  providerProfile      ProviderProfile     @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  restaurantId         String?
  restaurant           Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  restaurantTimeSlotId String?
  restaurantTimeSlot   RestaurantTimeSlot? @relation(fields: [restaurantTimeSlotId], references: [id], onDelete: SetNull)
  restaurantName       String
  reservationDate      DateTime
  startTime            String
  guests               Int
  status               BookingStatus       @default(pending_confirmation)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, reservationDate])
  @@index([customerId])
  @@index([providerProfileId, status])
}

// Customer -> platform. Exactly one of tourBookingId / hotelBookingId is set (CHECK in migration).
model Payment {
  id               String            @id @default(cuid())
  tourBookingId    String?
  tourBooking      TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId   String?
  hotelBooking     HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  gateway          PaymentGateway
  status           TransactionStatus @default(pending)
  amount           Decimal           @db.Decimal(12, 2)
  chargedAmount    Decimal           @db.Decimal(12, 2)
  chargedCurrency  String
  exchangeRate     Decimal?          @db.Decimal(18, 6)
  gatewayOrderId   String            @unique
  gatewayCaptureId String?           @unique
  paidAt           DateTime?
  failureReason    String?
  rawResponse      Json?

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourBookingId])
  @@index([hotelBookingId])
}

// Platform -> customer when a paid booking is cancelled.
model Refund {
  id              String            @id @default(cuid())
  tourBookingId   String?
  tourBooking     TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId  String?
  hotelBooking    HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  paymentId       String
  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status          TransactionStatus @default(pending)
  amount          Decimal           @db.Decimal(12, 2)
  chargedAmount   Decimal           @db.Decimal(12, 2)
  chargedCurrency String
  gatewayRefundId String?           @unique
  reason          String?
  processedAt     DateTime?
  failureReason   String?
  rawResponse     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourBookingId])
  @@index([hotelBookingId])
  @@index([paymentId])
}

// Platform -> provider after the service is completed.
model Payout {
  id                String            @id @default(cuid())
  tourBookingId     String?           @unique
  tourBooking       TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId    String?           @unique
  hotelBooking      HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile   @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  gateway           PaymentGateway
  status            TransactionStatus @default(pending)
  amount            Decimal           @db.Decimal(12, 2)
  chargedAmount     Decimal           @db.Decimal(12, 2)
  chargedCurrency   String
  exchangeRate      Decimal?          @db.Decimal(18, 6)
  receiver          String
  gatewayBatchId    String?
  gatewayItemId     String?           @unique
  paidAt            DateTime?
  failureReason     String?
  rawResponse       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerProfileId, status])
}

// Customer đánh giá sau khi đơn completed, mỗi đơn 1 review.
// Đúng 1 trong tourId / hotelId / restaurantId được set (CHECK trong migration).
model Review {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  content    String

  tourId       String?
  tour         Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotelId      String?
  hotel        Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tourBookingId       String?            @unique
  tourBooking         TourBooking?       @relation(fields: [tourBookingId], references: [id], onDelete: SetNull)
  hotelBookingId      String?            @unique
  hotelBooking        HotelBooking?      @relation(fields: [hotelBookingId], references: [id], onDelete: SetNull)
  restaurantBookingId String?            @unique
  restaurantBooking   RestaurantBooking? @relation(fields: [restaurantBookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, createdAt])
  @@index([hotelId, createdAt])
  @@index([restaurantId, createdAt])
}

enum ExternalPlaceKind {
  hotel
  restaurant
  destination
}

// Địa điểm ngoài hệ thống (OpenStreetMap/Nominatim) mà chatbot đã tra cứu — cache để tránh gọi lại API.
model ExternalPlace {
  id        String            @id @default(cuid())
  osmType   String // node | way | relation
  osmId     String
  kind      ExternalPlaceKind
  name      String
  address   String
  province  String?
  latitude  Decimal           @db.Decimal(9, 6)
  longitude Decimal           @db.Decimal(9, 6)
  category  String // OSM class, vd: amenity, tourism
  type      String // OSM type, vd: restaurant, hotel, attraction
  extra     Json              @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([osmType, osmId])
}

// Cache kết quả một lượt tìm kiếm ngoài: queryKey -> danh sách ExternalPlace.id (có hạn dùng).
model ExternalPlaceSearch {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  placeIds  String[]
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Cache xác định khu vực cho chat AI: địa danh người dùng nhập -> khung tọa độ hoặc danh sách tên trùng.
model ExternalArea {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  // { label, viewport } | { ambiguous: string[] } | null (không tìm thấy)
  result    Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Cấu hình hệ thống toàn sàn (singleton id = "default") do Admin quản lý.
model SystemSetting {
  id                          String  @id @default("default")
  commissionRate              Decimal @default(0.1) @db.Decimal(5, 4)
  usdRate                     Decimal @default(25000) @db.Decimal(18, 2)
  bookingHoldMinutes          Int     @default(10)
  customerCancelCutoffHours   Int     @default(24)
  restaurantCancelCutoffHours Int     @default(2)
  serviceDeleteGraceDays      Int     @default(30)

  platformName        String @default("Roamly")
  tagline             String @default("Người bạn đồng hành du lịch toàn diện cho khách sạn, nhà hàng, tour và những điểm đến khó quên.")
  contactAddress      String @default("70/A Tầng Divo Tower, Hà Nội, Việt Nam")
  contactPhone        String @default("(+84) 123 456 789")
  contactEmail        String @default("hello@roamly.vn")
  aboutVideoUrl       String @default("")
  aboutVideoPosterUrl String @default("")

  updatedAt DateTime @updatedAt
}
