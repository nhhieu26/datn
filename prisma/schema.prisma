generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  provider
  admin
}

enum UserStatus {
  active
  inactive
  banned
}

enum BusinessType {
  tour
  hotel
  restaurant
}

enum ApprovalStatus {
  not_submitted
  pending
  approved
  rejected
}

enum ProvinceType {
  province
  city
}

enum ServiceStatus {
  pending
  published
  paused
  rejected
}

enum TourDepartureStatus {
  scheduled
  full
  cancelled
  completed
}

enum BookingStatus {
  pending_payment
  confirmed
  completed
  cancelled
  expired
  no_show
}

enum PaymentGateway {
  paypal
}

enum TransactionStatus {
  pending
  processing
  succeeded
  failed
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String     @unique
  password            String
  fullname            String
  status              UserStatus @default(active)
  onboardingCompleted Boolean    @default(false)
  preferences         Json       @default("{}")
  role                Role

  providerProfiles   ProviderProfile[]
  tourBookings       TourBooking[]
  hotelBookings      HotelBooking[]
  restaurantBookings RestaurantBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessType    BusinessType
  taxCode         String?
  licenseUrl      String?
  website         String?
  address         String?
  description     String?
  photoUrl        String?
  photoFileId     String?
  approvalStatus  ApprovalStatus @default(not_submitted)
  rejectionReason String?
  payoutEmail     String?

  tours              Tour[]
  hotels             Hotel[]
  restaurants        Restaurant[]
  tourBookings       TourBooking[]
  hotelBookings      HotelBooking[]
  restaurantBookings RestaurantBooking[]
  payouts            Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessType])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  tours        TourTag[]
  hotels       HotelTag[]
  restaurants  RestaurantTag[]
  destinations DestinationTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Province {
  id       String       @id @default(cuid())
  name     String       @unique
  fullName String
  slug     String       @unique
  type     ProvinceType
  imageUrl String?

  tours        Tour[]
  hotels       Hotel[]
  restaurants  Restaurant[]
  destinations Destination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  description       String?
  images            Json            @default("[]")
  itinerary         Json            @default("[]")
  includeServices   String[]        @default([])
  excludeServices   String[]        @default([])
  durationDays      Int
  durationNights    Int
  basePrice         Decimal         @db.Decimal(12, 2)
  status            ServiceStatus   @default(pending)

  tags       TourTag[]
  departures TourDeparture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourTag {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([tourId, tagId])
}

model TourDeparture {
  id            String              @id @default(cuid())
  tourId        String
  tour          Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime?
  price         Decimal?            @db.Decimal(12, 2)
  totalSlots    Int
  bookedSlots   Int                 @default(0)
  status        TourDepartureStatus @default(scheduled)

  bookings TourBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hotel {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  latitude          Decimal?        @db.Decimal(9, 6)
  longitude         Decimal?        @db.Decimal(9, 6)
  images            Json            @default("[]")
  amenities         String[]        @default([])
  status            ServiceStatus   @default(pending)

  tags  HotelTag[]
  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelTag {
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([hotelId, tagId])
}

model Room {
  id          String        @id @default(cuid())
  hotelId     String
  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  images      Json          @default("[]")
  capacity    Int
  quantity    Int
  basePrice   Decimal       @db.Decimal(12, 2)
  amenities   String[]      @default([])
  status      ServiceStatus @default(pending)

  bookings HotelBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  latitude          Decimal?        @db.Decimal(9, 6)
  longitude         Decimal?        @db.Decimal(9, 6)
  phone             String?
  capacity          Int
  images            Json            @default("[]")
  menu              Json            @default("[]")
  status            ServiceStatus   @default(pending)

  tags      RestaurantTag[]
  timeSlots RestaurantTimeSlot[]
  bookings  RestaurantBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantTag {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([restaurantId, tagId])
}

model RestaurantTimeSlot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startTime    String
  endTime      String

  bookings RestaurantBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, startTime])
}

model Destination {
  id          String   @id @default(cuid())
  provinceId  String
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  address     String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  images      Json     @default("[]")
  ticketPrice Decimal? @db.Decimal(12, 2)
  isPublished Boolean  @default(true)

  tags DestinationTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DestinationTag {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([destinationId, tagId])
}

model TourBooking {
  id                String          @id @default(cuid())
  code              String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  tourDepartureId   String?
  tourDeparture     TourDeparture?  @relation(fields: [tourDepartureId], references: [id], onDelete: SetNull)
  tourTitle         String
  departureDate     DateTime
  adults            Int
  children          Int             @default(0)
  status            BookingStatus   @default(pending_payment)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  unitPrice      Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  commissionRate Decimal @db.Decimal(5, 4)
  platformFee    Decimal @db.Decimal(12, 2)
  providerAmount Decimal @db.Decimal(12, 2)

  expiresAt    DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payments Payment[]
  refunds  Refund[]
  payout   Payout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([providerProfileId, status])
  @@index([status, departureDate])
}

model HotelBooking {
  id                String          @id @default(cuid())
  code              String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  roomId            String?
  room              Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  hotelName         String
  roomName          String
  checkInDate       DateTime
  checkOutDate      DateTime
  nights            Int
  roomQuantity      Int
  guests            Int
  status            BookingStatus   @default(pending_payment)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  unitPrice      Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  commissionRate Decimal @db.Decimal(5, 4)
  platformFee    Decimal @db.Decimal(12, 2)
  providerAmount Decimal @db.Decimal(12, 2)

  expiresAt    DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payments Payment[]
  refunds  Refund[]
  payout   Payout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, checkInDate, checkOutDate])
  @@index([customerId])
  @@index([providerProfileId, status])
  @@index([status, checkOutDate])
}

model RestaurantBooking {
  id                   String              @id @default(cuid())
  code                 String              @unique
  customerId           String
  customer             User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId    String
  providerProfile      ProviderProfile     @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  restaurantId         String?
  restaurant           Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  restaurantTimeSlotId String?
  restaurantTimeSlot   RestaurantTimeSlot? @relation(fields: [restaurantTimeSlotId], references: [id], onDelete: SetNull)
  restaurantName       String
  reservationDate      DateTime
  startTime            String
  guests               Int
  status               BookingStatus       @default(confirmed)

  contactName  String
  contactPhone String
  contactEmail String
  note         String?

  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, reservationDate])
  @@index([customerId])
  @@index([providerProfileId, status])
}

// Customer -> platform. Exactly one of tourBookingId / hotelBookingId is set (CHECK in migration).
model Payment {
  id               String            @id @default(cuid())
  tourBookingId    String?
  tourBooking      TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId   String?
  hotelBooking     HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  gateway          PaymentGateway
  status           TransactionStatus @default(pending)
  amount           Decimal           @db.Decimal(12, 2)
  chargedAmount    Decimal           @db.Decimal(12, 2)
  chargedCurrency  String
  exchangeRate     Decimal?          @db.Decimal(18, 6)
  gatewayOrderId   String            @unique
  gatewayCaptureId String?           @unique
  paidAt           DateTime?
  failureReason    String?
  rawResponse      Json?

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourBookingId])
  @@index([hotelBookingId])
}

// Platform -> customer when a paid booking is cancelled.
model Refund {
  id              String            @id @default(cuid())
  tourBookingId   String?
  tourBooking     TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId  String?
  hotelBooking    HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  paymentId       String
  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status          TransactionStatus @default(pending)
  amount          Decimal           @db.Decimal(12, 2)
  chargedAmount   Decimal           @db.Decimal(12, 2)
  chargedCurrency String
  gatewayRefundId String?           @unique
  reason          String?
  processedAt     DateTime?
  failureReason   String?
  rawResponse     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourBookingId])
  @@index([hotelBookingId])
  @@index([paymentId])
}

// Platform -> provider after the service is completed.
model Payout {
  id                String            @id @default(cuid())
  tourBookingId     String?           @unique
  tourBooking       TourBooking?      @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  hotelBookingId    String?           @unique
  hotelBooking      HotelBooking?     @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ProviderProfile   @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  gateway           PaymentGateway
  status            TransactionStatus @default(pending)
  amount            Decimal           @db.Decimal(12, 2)
  chargedAmount     Decimal           @db.Decimal(12, 2)
  chargedCurrency   String
  exchangeRate      Decimal?          @db.Decimal(18, 6)
  receiver          String
  gatewayBatchId    String?
  gatewayItemId     String?           @unique
  paidAt            DateTime?
  failureReason     String?
  rawResponse       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerProfileId, status])
}
