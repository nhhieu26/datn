generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  provider
}

enum UserStatus {
  active
  inactive
  banned
}

enum BusinessType {
  tour
  hotel
  restaurant
}

enum ApprovalStatus {
  not_submitted
  pending
  approved
  rejected
}

enum ProvinceType {
  province
  city
}

enum ServiceStatus {
  pending
  published
  paused
  rejected
}

enum TourDepartureStatus {
  scheduled
  full
  cancelled
  completed
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String     @unique
  password            String
  fullname            String
  status              UserStatus @default(active)
  onboardingCompleted Boolean    @default(false)
  preferences         Json       @default("{}")
  role                Role

  providerProfiles ProviderProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessType    BusinessType
  taxCode         String?
  licenseUrl      String?
  website         String?
  address         String?
  description     String?
  photoUrl        String?
  photoFileId     String?
  approvalStatus  ApprovalStatus @default(not_submitted)
  rejectionReason String?

  tours       Tour[]
  hotels      Hotel[]
  restaurants Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessType])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  tours       TourTag[]
  restaurants RestaurantTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Province {
  id       String       @id @default(cuid())
  name     String       @unique
  fullName String
  slug     String       @unique
  type     ProvinceType
  imageUrl String?

  tours       Tour[]
  hotels      Hotel[]
  restaurants Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  description       String?
  images            Json            @default("[]")
  itinerary         Json            @default("[]")
  includeServices   String[]        @default([])
  excludeServices   String[]        @default([])
  durationDays      Int
  durationNights    Int
  basePrice         Decimal         @db.Decimal(12, 2)
  status            ServiceStatus   @default(pending)

  tags       TourTag[]
  departures TourDeparture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourTag {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([tourId, tagId])
}

model TourDeparture {
  id            String              @id @default(cuid())
  tourId        String
  tour          Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime?
  price         Decimal?            @db.Decimal(12, 2)
  totalSlots    Int
  bookedSlots   Int                 @default(0)
  status        TourDepartureStatus @default(scheduled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hotel {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  images            Json            @default("[]")
  amenities         String[]        @default([])
  status            ServiceStatus   @default(pending)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String        @id @default(cuid())
  hotelId     String
  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  images      Json          @default("[]")
  capacity    Int
  quantity    Int
  basePrice   Decimal       @db.Decimal(12, 2)
  amenities   String[]      @default([])
  status      ServiceStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id                String          @id @default(cuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  provinceId        String
  province          Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name              String
  slug              String          @unique
  description       String?
  address           String
  phone             String?
  capacity          Int
  images            Json            @default("[]")
  menu              Json            @default("[]")
  status            ServiceStatus   @default(pending)

  tags      RestaurantTag[]
  timeSlots RestaurantTimeSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantTag {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([restaurantId, tagId])
}

model RestaurantTimeSlot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startTime    String
  endTime      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, startTime])
}
